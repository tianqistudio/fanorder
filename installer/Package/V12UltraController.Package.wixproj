<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <TargetName>V12UltraController</TargetName>
    <OutputPath>$(MSBuildThisFileDirectory)bin\$(Configuration)\</OutputPath>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.0</ProductVersion>
    <PublishRoot Condition="'$(PublishRoot)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\publish</PublishRoot>
    <DefineConstants>$(DefineConstants);ProductVersion=$(ProductVersion);PublishRoot=$([System.IO.Path]::GetFullPath('$(PublishRoot)'))</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
  </ItemGroup>
</Project>
