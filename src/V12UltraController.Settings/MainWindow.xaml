<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="V12UltraController.Settings.MainWindow" Title="风序 · FanOrder 设置" Width="1200" Height="820" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI">
    <Grid x:Name="WindowLayoutGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="184" x:Name="NavigationColumn" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>
        <Border Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Tag="device">
                    <TextBlock Text="风序 · FanOrder" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="DeviceSwitchButton" Content="llano V12Ultra  ▾" HorizontalAlignment="Left" Margin="20,0,0,0" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="切换设备型号" Click="DeviceSwitchButton_Click" ToolTip="仅适配绿巨能 V12Ultra（原 V16）AI 智控款；选择不等于已连接。" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Tag="connection">
                    <Button x:Name="StartBackendButton" Content="启动后台" Margin="0,0,12,0" Style="{StaticResource SecondaryButtonStyle}" ToolTip="只启动后台，不改自启；已接管时恢复保存策略。" Click="StartBackendButton_Click" />
                    <Ellipse x:Name="ConnectionIndicator" Width="9" Height="9" Margin="0,0,9,0" Fill="#FF6B78" />
                    <TextBlock x:Name="ConnectionText" Text="正在连接服务…" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button Content="刷新" Click="RefreshButton_Click" Style="{StaticResource SecondaryButtonStyle}" ToolTip="刷新后台状态 (F5)" Margin="12,0,0,0" />
                    <Button Content="i" Style="{StaticResource InfoButtonStyle}" HorizontalAlignment="Left" AutomationProperties.Name="控制可用性">
                        <Button.ToolTip>
                            <TextBlock x:Name="ControlAvailabilityText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0" MaxWidth="420" />
                        </Button.ToolTip>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Padding="12,20">
            <StackPanel x:Name="PrimaryNavigationPanel" />
        </Border>
        <Grid Grid.Row="1" Grid.Column="1" Margin="24,18,24,12" x:Name="PageContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="PageTitleText" Text="控制" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,10" />
            <WrapPanel x:Name="SecondaryNavigationPanel" Grid.Row="1" Margin="0,0,0,14" />
            <Border x:Name="GlobalStatusBanner" Grid.Row="2" Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,0,10" Visibility="Collapsed">
                <DockPanel>
                    <Button Content="查看详情" Click="GlobalStatusDetails_Click" DockPanel.Dock="Right" Style="{StaticResource CompactActionButtonStyle}" Margin="12,0,0,0" x:Name="GlobalStatusDetailsButton" />
                    <TextBlock x:Name="GlobalStatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <Border x:Name="PageFeedbackBorder" Grid.Row="3" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
                <DockPanel>
                    <Button Content="×" FontFamily="Segoe UI" DockPanel.Dock="Right" Click="DismissPageFeedback_Click" Style="{StaticResource CompactActionButtonStyle}" MinWidth="28" Padding="6" Margin="10,0,0,0" AutomationProperties.Name="关闭当前页面反馈" />
                    <TextBlock x:Name="PageFeedbackText" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </DockPanel>
            </Border>
            <TabControl x:Name="MainTabs" Grid.Row="4" Background="Transparent" BorderThickness="0" TabStripPlacement="Left" SelectionChanged="MainTabs_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="概览" Tag="overview">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,8,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="控制方式" Style="{StaticResource CaptionStyle}" />
                                        <TextBlock x:Name="OverviewControlModeText" Text="—" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,10,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="风扇状态" Style="{StaticResource CaptionStyle}" />
                                        <TextBlock x:Name="OverviewFanStateText" Text="—" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,10,0" />
                                    </StackPanel>
                                    <Border Style="{x:Null}" Margin="0" Padding="12,0,0,0" MinHeight="0" Grid.Column="2">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <TextBlock Text="设备" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <Button Content="i" Style="{StaticResource InfoButtonStyle}" HorizontalAlignment="Right" AutomationProperties.Name="设备说明" Margin="6,0,0,0">
                                                    <Button.ToolTip>
                                                        <TextBlock x:Name="DeviceIdentityText" Text="—" Margin="0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="420" />
                                                    </Button.ToolTip>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock x:Name="DeviceStateText" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,8,12" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="快捷控制" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />
                                    <WrapPanel Margin="0">
                                        <Button x:Name="HomeFanToggleButton" Content="风扇未知 · 刷新" Click="HomeFanToggle_Click" Style="{StaticResource CompactActionButtonStyle}" Margin="0,0,8,4" />
                                        <Button Content="风扇设置" Click="OpenFan_Click" Style="{StaticResource CompactActionButtonStyle}" Margin="0,0,8,4" />
                                        <Button x:Name="HomeLightToggleButton" Content="灯光未知 · 刷新" Click="HomeLightToggle_Click" Style="{StaticResource CompactActionButtonStyle}" Margin="0,0,8,4" />
                                        <Button Content="灯光设置" Click="OpenLighting_Click" Style="{StaticResource CompactActionButtonStyle}" Margin="0,0,8,4" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Tag="metrics">
                                <UniformGrid Columns="3" Margin="0,0,0,4" x:Name="OverviewMetricsGrid">
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,8,8" Padding="14" MinHeight="116">
                                        <StackPanel>
                                            <TextBlock Text="控制温度" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock x:Name="ControlTemperatureText" Text="—" FontSize="26" FontWeight="SemiBold" Margin="0,7,0,0" />
                                            <TextBlock x:Name="TemperatureDetailText" Text="CPU —  |  GPU —" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,8,8" Padding="14" MinHeight="116">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <TextBlock x:Name="FanTargetLabelText" Text="风扇目标" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <Button Content="i" Style="{StaticResource InfoButtonStyle}" HorizontalAlignment="Right" AutomationProperties.Name="风扇目标说明" Margin="6,0,0,0">
                                                    <Button.ToolTip>
                                                        <TextBlock x:Name="FanModeText" Text="—" Margin="0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="420" />
                                                    </Button.ToolTip>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock x:Name="FanPercentText" Text="—" FontSize="26" FontWeight="SemiBold" Margin="0,7,0,0" />
                                            <TextBlock x:Name="FanReadbackText" Text="设备回读：未知 / RPM 未知" Margin="0,5,0,0" TextWrapping="Wrap" ToolTip="按校准点估算 RPM，非实时读数。" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,8,8" Padding="14" MinHeight="116">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <TextBlock Text="安全保护" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <Button Content="i" Style="{StaticResource InfoButtonStyle}" HorizontalAlignment="Right" AutomationProperties.Name="故障安全说明" Margin="6,0,0,0">
                                                    <Button.ToolTip>
                                                        <TextBlock x:Name="FailSafeReasonText" Text="—" Margin="0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="420" />
                                                    </Button.ToolTip>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock x:Name="FailSafeStateText" Text="—" FontSize="26" FontWeight="SemiBold" Margin="0,9,0,0" />
                                            <WrapPanel Margin="0,8,0,0">
                                                <Button x:Name="DisableSafetyProtectionButton" Content="禁用安全保护" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,0,6,0" Padding="10,5" MinWidth="0" MinHeight="28" FontSize="12" IsEnabled="False" Click="DisableSafetyProtectionButton_Click" AutomationProperties.Name="禁用安全保护" ToolTipService.ShowOnDisabled="True" ToolTip="禁用保护，并恢复保存的手动转速；故障中可能仅完成禁用。" />
                                                <Button x:Name="ResumeSafetyProtectionButton" Content="恢复保护…" Style="{StaticResource SecondaryButtonStyle}" Margin="0" Padding="10,5" MinWidth="0" MinHeight="28" FontSize="12" Visibility="Collapsed" IsEnabled="False" Click="ResumeSafetyProtectionButton_Click" AutomationProperties.Name="恢复安全保护" ToolTip="解除停止后才会自动调节；硬件故障需单独处理。" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                            <Border Style="{StaticResource CardStyle}" Margin="0,4,8,8" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="已保存方案" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" />
                                        <ComboBox x:Name="OverviewProfileCombo" DisplayMemberPath="Name" SelectedValuePath="Id" MinWidth="160" MaxWidth="280" HorizontalAlignment="Left" AutomationProperties.Name="选择已保存方案" />
                                        <TextBlock x:Name="OverviewProfileText" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,6,10,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="OverviewApplyProfileButton" Content="应用方案" Click="OverviewApplyProfile_Click" Style="{StaticResource CompactActionButtonStyle}" />
                                        <Button Content="管理…" Click="OpenProfiles_Click" Style="{StaticResource CompactActionButtonStyle}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="风扇" Tag="fan">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Tag="fan">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,8,16">
                                <StackPanel>
                                    <TextBlock Text="当前控制方式" FontSize="17" FontWeight="SemiBold" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock x:Name="CurrentControlModeText" Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,14" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="AutoModeButton" Content="自动曲线" Style="{StaticResource ActionButtonStyle}" Click="AutoModeButton_Click" />
                                        <Button x:Name="ManualModeButton" Content="手动控制" Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="ManualModeButton_Click" />
                                        <Button Content="i" Style="{StaticResource InfoButtonStyle}" HorizontalAlignment="Left" AutomationProperties.Name="控制说明">
                                            <Button.ToolTip>
                                                <TextBlock x:Name="ControlProtectionText" Text="普通手动仍受保护；纯手动停止所有自动调节。" Margin="0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="420" />
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>
                                    <Separator Margin="0,12" Background="{DynamicResource BorderBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button x:Name="FanOnButton" Content="开启风扇" IsEnabled="False" Style="{StaticResource ActionButtonStyle}" Click="FanOnButton_Click" />
                                        <Button x:Name="FanOffButton" Content="关闭风扇…" IsEnabled="False" Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="FanOffButton_Click" />
                                        <Button Content="i" Style="{StaticResource InfoButtonStyle}" HorizontalAlignment="Left" AutomationProperties.Name="控制说明">
                                            <Button.ToolTip>
                                            <TextBlock x:Name="FanPowerHelpText" Text="关扇仅限低温；升温或故障会自动开扇。退出窗口不影响后台。" TextWrapping="Wrap" Margin="0" MaxWidth="420" />
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="手动转速" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ManualSpeedValueText" Text="100% · 约 2800 RPM（估算）" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Slider x:Name="ManualSpeedSlider" Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="False" Margin="0,10,0,0" ValueChanged="ManualSpeedSlider_ValueChanged" />
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <TextBox x:Name="ManualSpeedInput" Width="76" MinHeight="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Padding="10,6" MaxLength="3" AutomationProperties.Name="手动转速百分比" TextChanged="ManualSpeedInput_TextChanged" KeyDown="ManualSpeedInput_KeyDown" LostKeyboardFocus="ManualSpeedInput_LostKeyboardFocus" />
                                        <TextBlock Text="%" VerticalAlignment="Center" Margin="8,0,18,0" />
                                        <Button x:Name="ApplyManualSpeedButton" Content="应用手动速度" IsEnabled="False" HorizontalAlignment="Left" Margin="0" Style="{StaticResource ActionButtonStyle}" Click="ApplyManualSpeedButton_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="ManualSpeedValidationText" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Margin="0,6,0,0" Visibility="Collapsed" />
                                    <Expander Header="高级控制" Margin="0,12,0,0">
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button x:Name="PureManualButton" Content="纯手动 / 停止温控" Margin="0,0,8,4" Click="PureManualButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
                                            <Button x:Name="ReleaseControlButton" Content="释放控制…" Click="ReleaseControlButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,4" ToolTip="释放本程序的设备控制，设置窗口保持打开。" />
                                        </WrapPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                            <Expander x:Name="CurveEditorExpander" Header="自动曲线编辑" IsExpanded="False" Margin="0,0,8,12">
                                <StackPanel>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,12">
                                        <StackPanel>
                                            <TextBlock x:Name="CurveDraftStateText" Text="曲线草稿" Style="{StaticResource CaptionStyle}" Margin="0,0,0,12" />
                                            <Viewbox Height="115" Stretch="Fill">
                                                <Canvas Width="600" Height="115" ClipToBounds="True">
                                                    <Line X1="0" X2="600" Y1="114" Y2="114" Stroke="{DynamicResource BorderBrush}" />
                                                    <Line X1="0" X2="600" Y1="57" Y2="57" Stroke="{DynamicResource BorderBrush}" />
                                                    <Path x:Name="CurvePreviewPath" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2.5" />
                                                </Canvas>
                                            </Viewbox>
                                            <DockPanel Margin="0,8,0,0">
                                                <TextBlock Text="0°C" Style="{StaticResource CaptionStyle}" />
                                                <TextBlock Text="温度 → 100°C · 目标 0–100%" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                    <Grid Margin="0" Height="380">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0">
                                                    <TextBlock Text="温控曲线" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    <Button Content="i" Style="{StaticResource InfoButtonStyle}" HorizontalAlignment="Left" AutomationProperties.Name="温控曲线说明" Margin="6,0,0,0">
                                                        <Button.ToolTip>
                                                            <TextBlock Text="自动调节按曲线运行；状态看当前模式和保护。" Margin="0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="420" x:Name="CurveExplanationText" />
                                                        </Button.ToolTip>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <DataGrid x:Name="CurveGrid" Grid.Row="1" ItemsSource="{Binding CurvePoints}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" RowBackground="{DynamicResource SurfaceBrush}" AlternatingRowBackground="{DynamicResource SurfaceRaisedBrush}" HorizontalGridLinesBrush="{DynamicResource BorderBrush}" ColumnHeaderHeight="38" RowHeight="38" CellEditEnding="CurveGrid_CellEditEnding">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Setter Property="Padding" Value="12,8" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.CellStyle>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="Padding" Value="12,4" />
                                                </Style>
                                            </DataGrid.CellStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="温度 (°C)" Binding="{Binding TemperatureCelsius, UpdateSourceTrigger=PropertyChanged}" MinWidth="180" Width="*" />
                                                <DataGridTextColumn Header="风扇百分比" Binding="{Binding FanPercent, UpdateSourceTrigger=PropertyChanged}" MinWidth="180" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <WrapPanel Grid.Row="2" Margin="0,14,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,8,8">
                                                <Button Content="添加点" Style="{StaticResource SecondaryButtonStyle}" Click="AddCurvePointButton_Click" />
                                                <Button Content="删除选中点" Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="RemoveCurvePointButton_Click" />
                                                <Button Content="恢复默认" Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="ResetCurveButton_Click" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,8">
                                                <Button x:Name="LoadCurveButton" Content="读取已保存曲线" Style="{StaticResource SecondaryButtonStyle}" Click="LoadCurveButton_Click" />
                                                <Button x:Name="ApplyCurveButton" Content="验证并应用" Margin="10,0,0,0" Style="{StaticResource ActionButtonStyle}" Click="ApplyCurveButton_Click" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="灯光" Tag="lighting">
                    <Grid Margin="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,0,8,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top" Margin="0,0,16,0">
                                    <StackPanel>
                                        <TextBlock Text="预览" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,7,0,4">
                                            <TextBlock Text="灯光预览" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <Button Content="i" Style="{StaticResource InfoButtonStyle}" HorizontalAlignment="Left" AutomationProperties.Name="灯光预览说明" Margin="6,0,0,0">
                                                <Button.ToolTip>
                                                    <TextBlock Text="仅示意颜色，不代表亮度或动画。&#10;设备只支持预设。" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0" TextWrapping="Wrap" MaxWidth="420" />
                                                </Button.ToolTip>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="草稿预览" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <Grid Height="175" Margin="0,12">
                                            <Ellipse Width="150" Height="150" Stroke="{DynamicResource BorderBrush}" StrokeThickness="13" />
                                            <Ellipse x:Name="LightingPreviewRing" Width="150" Height="150" Stroke="#FF596A" StrokeThickness="8" />
                                            <Ellipse Width="118" Height="118" Fill="{DynamicResource WindowBrush}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="V12" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                <TextBlock x:Name="LightingPreviewLabel" Text="单色常亮" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="LightingDraftText" Text="尚未读取 · 仅本地草稿" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="灯光模式" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                                            <CheckBox x:Name="LightingEnabledCheckBox" Content="开启灯光 · 不改变风扇电源" Foreground="{DynamicResource TextPrimaryBrush}" IsChecked="True" Margin="0,0,0,16" Checked="LightingDraft_Changed" Unchecked="LightingDraft_Changed" />
                                            <ListBox x:Name="LightingModeCombo" Style="{StaticResource LightingChoicesStyle}" SelectedIndex="0" SelectionChanged="LightingDraft_Changed" AutomationProperties.Name="灯光模式">
                                                <ListBoxItem AutomationProperties.Name="单色常亮">
                                                    <StackPanel>
                                                        <TextBlock Text="01" Foreground="#74BEFF" FontSize="19" />
                                                        <TextBlock Text="单色常亮" Margin="0,6,0,0" />
                                                    </StackPanel>
