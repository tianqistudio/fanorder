                                                <Button Content="i" Style="{StaticResource InfoButtonStyle}" HorizontalAlignment="Left" AutomationProperties.Name="准备配对说明" Margin="6,0,0,0">
                                                    <Button.ToolTip>
                                                        <TextBlock Text="低负载接市电，退出 Myth.Cool 并留在旁边；向导不强退。" Margin="0" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" MaxWidth="420" />
                                                    </Button.ToolTip>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <CheckBox x:Name="AttendedCheckBox" Content="我正在设备旁看护，并且已主动退出 Myth.Cool" Margin="4,18,0,14" Foreground="{DynamicResource TextPrimaryBrush}" Checked="AttendedCheckBox_Changed" Unchecked="AttendedCheckBox_Changed" />
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource SurfaceRaisedBrush}">
                                                <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,20,0">
                                                <TextBlock Text="探测身份" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock x:Name="ProbeResultText" Text="验证 VID/PID、Usage、固件和报告长度。" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button x:Name="ProbeButton" Grid.Column="2" Content="开始探测" Style="{StaticResource ActionButtonStyle}" IsEnabled="False" Click="ProbeButton_Click" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource SurfaceRaisedBrush}">
                                                <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,20,0">
                                                <TextBlock Text="等值写回" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock x:Name="IdempotentResultText" Text="写回原状态并复读，确认 RGB 不变。" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button x:Name="IdempotentButton" Grid.Column="2" Content="验证等值写回" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" Click="IdempotentButton_Click" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource SurfaceRaisedBrush}">
                                                <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,20,0">
                                                <TextBlock Text="分级测试" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock x:Name="TestResultText" Text="低于60°C测 50% → 70% → 100%；60–90°C仅测100%；≥90°C或失效即停。" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button x:Name="TestButton" Grid.Column="2" Content="执行分级测试" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" Click="TestButton_Click" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource SurfaceRaisedBrush}">
                                                <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,20,0">
                                                <TextBlock Text="正式接管" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock x:Name="CommitResultText" Text="备份并停用 Myth.Cool 任务，服务独占写入。" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button x:Name="CommitButton" Grid.Column="2" Content="正式接管" Background="#2AA876" Style="{StaticResource ActionButtonStyle}" IsEnabled="False" Click="CommitButton_Click" />
                                        </Grid>
                                    </Border>
                                    <Border x:Name="ForcedUninstallRecoveryBorder" Visibility="Collapsed" Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="#D88A31" BorderThickness="2" CornerRadius="12" Padding="18" Margin="0,0,0,18">
                                        <StackPanel>
                                            <TextBlock Text="强制卸载后的有人看护恢复" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                                            <TextBlock x:Name="ForcedUninstallRecoveryText" Margin="0,7,0,0" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                            <CheckBox x:Name="ForcedRecoveryAttendedCheckBox" Content="我在电脑旁并会观察设备" Margin="0,12,0,0" Foreground="{DynamicResource TextPrimaryBrush}" IsEnabled="False" Checked="ForcedRecoveryAttendedCheckBox_Changed" Unchecked="ForcedRecoveryAttendedCheckBox_Changed" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="#8C6739" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,18">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,20,0">
                                                <TextBlock Text="恢复不确定的计划任务变更" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                                            <TextBlock x:Name="TaskTransitionRecoveryResultText" Text="只处理已有恢复日志；核验任务 XML 和状态，不运行命令。" Margin="0,5,0,0" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button x:Name="RecoverTaskTransitionButton" Grid.Column="1" Content="核验并恢复" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" Click="RecoverTaskTransitionButton_Click" />
                                        </Grid>
                                    </Border>
                                    <Border Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="#743642" BorderThickness="1" CornerRadius="12" Padding="18">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0">
                                                    <TextBlock Text="回滚到 Myth.Cool" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    <Button Content="i" Style="{StaticResource InfoButtonStyle}" HorizontalAlignment="Left" AutomationProperties.Name="回滚到 Myth.Cool说明" Margin="6,0,0,0">
                                                        <Button.ToolTip>
                                                            <TextBlock Text="尝试恢复 100%，停止自研控制并恢复原任务。" Margin="0" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" MaxWidth="420" />
                                                        </Button.ToolTip>
                                                    </Button>
                                                </StackPanel>
                                                <CheckBox x:Name="StartMythCoolCheckBox" Content="回滚成功后立即启动 Myth.Cool" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                            <Button x:Name="RollbackButton" Grid.Column="1" Content="回滚" Background="#B94755" Style="{StaticResource ActionButtonStyle}" IsEnabled="False" Click="RollbackButton_Click" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="ShutdownExpander" Header="关机停扇" Style="{StaticResource SettingsExpanderStyle}" Tag="shutdown">
                                <StackPanel>
                                    <Border Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="#B94755" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0">
                                                <TextBlock Text="有人看护的高风险资格测试" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <Button Content="i" Style="{StaticResource InfoButtonStyle}" HorizontalAlignment="Left" AutomationProperties.Name="关机停扇测试条件与限制" Margin="6,0,0,0" x:Name="ShutdownHelpButton">
                                                    <Button.ToolTip>
                                                        <StackPanel>
                                                            <TextBlock Text="测试与看护条件" FontWeight="SemiBold" Margin="0,0,0,5" />
                                                            <TextBlock Margin="0" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Text="短暂关扇后恢复并回读；仅生成 2 分钟内存资格，不启用关机关闭。需人在旁、低负载、低于 60°C，且 Myth.Cool 已退出。" MaxWidth="420" />
                                                            <TextBlock Text="Windows 行为与限制" FontWeight="SemiBold" Margin="0,12,0,5" />
                                                            <TextBlock Margin="0" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Text="Restart 可能短暂关扇；快速启动、睡眠/休眠不保证。断电或驱动不可见时无法保证。" MaxWidth="420" />
                                                            <TextBlock Text="禁用与操作范围" FontWeight="SemiBold" Margin="0,12,0,5" />
                                                            <TextBlock Margin="0" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Text="不提供即时停扇、灯光或原始 HID；禁用只恢复 KeepAt100。" MaxWidth="420" />
                                                        </StackPanel>
                                                    </Button.ToolTip>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="当前关机策略" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock x:Name="ShutdownStateText" Text="正在读取服务状态…" Margin="0,9,0,0" FontSize="21" FontWeight="SemiBold" />
                                            <TextBlock x:Name="ShutdownQualificationText" Text="—" Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <CheckBox x:Name="ShutdownAttendedCheckBox" Content="我在旁看护、低负载、低于 60°C，且 Myth.Cool 已退出" Margin="4,4,0,14" Foreground="{DynamicResource TextPrimaryBrush}" Checked="ShutdownAttendedCheckBox_Changed" Unchecked="ShutdownAttendedCheckBox_Changed" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="QualifyShutdownButton" Content="1. 执行资格测试" Style="{StaticResource ActionButtonStyle}" IsEnabled="False" Click="QualifyShutdownButton_Click" />
                                        <Button x:Name="EnableShutdownButton" Content="2. 已观察恢复，确认启用" Margin="12,0,0,0" Style="{StaticResource ActionButtonStyle}" IsEnabled="False" Click="EnableShutdownButton_Click" />
                                        <Button x:Name="DisableShutdownButton" Content="禁用并恢复 KeepAt100" Margin="12,0,0,0" Background="#B94755" Style="{StaticResource ActionButtonStyle}" IsEnabled="False" Click="DisableShutdownButton_Click" />
                                    </StackPanel>
                                    <Button x:Name="ShutdownAndTurnOffButton" Content="关机并关闭风扇" Margin="0,12,0,0" Background="#B94755" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left" IsEnabled="False" Click="ShutdownAndTurnOffButton_Click" ToolTip="仅在关机停扇已启用且设备身份匹配时可用。" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="关于" Tag="about">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,18">
                            <TextBlock Text="版本信息" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,18" />
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="VersionStatusText" Text="后台尚未连接" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CompatibilityText" Margin="0,12,0,0" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="仅适配绿巨能（llano）V12Ultra（原 V16）AI 智控款笔记本压风式散热器。" />
                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="京东商品编号：100211395916 · 国补备案型号：SV107。V11、V11 Pro、普通 V12 及其他型号不在适配范围内。" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="制作者" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,24,10" />
                                    <TextBlock Grid.Column="1" Text="tianqistudio" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <TextBlock Grid.Row="1" Text="官网" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,24,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1">
                                        <Hyperlink Click="OpenOfficialWebsite_Click" Foreground="{DynamicResource PrimaryBrush}" ToolTip="在浏览器中打开官网" AutomationProperties.Name="打开官网 tianqistudio.com">tianqistudio.com</Hyperlink>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0">
                                        <TextBlock Text="实机验收边界" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <Button Content="i" Style="{StaticResource InfoButtonStyle}" HorizontalAlignment="Left" AutomationProperties.Name="实机验收边界说明" Margin="6,0,0,0">
                                            <Button.ToolTip>
                                                <TextBlock Text="灯效、断电、睡眠/唤醒、72小时运行暂无实机记录；离线测试不等于验收。" Margin="0" TextWrapping="Wrap" MaxWidth="420" />
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock x:Name="AcceptanceText" Margin="0,10,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,6">
            <DockPanel Tag="status">
                <TextBlock x:Name="LastRefreshText" DockPanel.Dock="Right" Text="尚未刷新" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock x:Name="ActivityText" Text="就绪" Margin="0,0,16,0" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>


