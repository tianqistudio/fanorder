<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>TianqiStudio.DesktopShortcuts.Wpf</AssemblyName>
    <RootNamespace>TianqiStudio.DesktopShortcuts.Wpf</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>TianqiStudio.DesktopShortcuts.Wpf</PackageId>
    <Version>0.1.0</Version>
    <Authors>tianqistudio</Authors>
    <Description>WPF RegisterHotKey adapter for TianqiStudio.DesktopShortcuts.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TianqiStudio.DesktopShortcuts/TianqiStudio.DesktopShortcuts.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
