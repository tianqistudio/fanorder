<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>V12UltraController.Service</AssemblyName>
    <RootNamespace>V12UltraController.Service</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../V12UltraController.Core/V12UltraController.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <Content Update="packages.lock.json"
             CopyToOutputDirectory="Never"
             CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
