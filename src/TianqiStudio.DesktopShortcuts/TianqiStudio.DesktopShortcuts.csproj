<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TianqiStudio.DesktopShortcuts</AssemblyName>
    <RootNamespace>TianqiStudio.DesktopShortcuts</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>TianqiStudio.DesktopShortcuts</PackageId>
    <Version>0.1.0</Version>
    <Authors>tianqistudio</Authors>
    <Description>Reusable shortcut bindings, persistence and injectable registration for Windows desktop applications.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
